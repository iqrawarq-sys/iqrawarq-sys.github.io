[[78,1,582,"عَمَّ يَتَسَآءَلُونَ ١"],[78,2,582,"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ ٢"],[78,3,582,"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ ٣"],[78,4,582,"كـَلَّا سَيَعۡلَمُونَ ٤"],[78,5,582,"ثُمَّ كـَلَّا سَيَعۡلَمُونَ ٥"],[78,6,582,"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا ٦"],[78,7,582,"وَٱلۡجِبَالَ أَوۡتَادٗا ٧"],[78,8,582,"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا ٨"],[78,9,582,"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا ٩"],[78,10,582,"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا ١٠"],[78,11,582,"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا ١١"],[78,12,582,"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا ١٢"],[78,13,582,"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا ١٣"],[78,14,582,"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا ١٤"],[78,15,582,"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا ١٥"],[78,16,582,"وَجَنَّٰتٍ أَلۡفَافًا ١٦"],[78,17,582,"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا ١٧"],[78,18,582,"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا ١٨"],[78,19,582,"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا ١٩"],[78,20,582,"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا ٢٠"],[78,21,582,"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا ٢١"],[78,22,582,"لِّلطَّٰغِينَ مَـَٔابٗا ٢٢"],[78,23,582,"لَّٰبِثِينَ فِيهَآ أَحۡقَابٗا ٢٣"],[78,24,582,"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا ٢٤"],[78,25,582,"إِلَّا حَمِيمٗا وَغَسَّاقٗا ٢٥"],[78,26,582,"جَزَآءٗ وِفَاقًا ٢٦"],[78,27,582,"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا ٢٧"],[78,28,582,"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا ٢٨"],[78,29,582,"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا ٢٩"],[78,30,582,"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا ٣٠"],[78,31,583,"إِنَّ لِلۡمُتَّقِينَ مَفَازًا ٣١"],[78,32,583,"حَدَآئِقَ وَأَعۡنَٰبٗا ٣٢"],[78,33,583,"وَكَوَاعِبَ أَتۡرَابٗا ٣٣"],[78,34,583,"وَكَأۡسٗا دِهَاقٗا ٣٤"],[78,35,583,"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا ٣٥"],[78,36,583,"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا ٣٦"],[78,37,583,"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا ٣٧"],[78,38,583,"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا ٣٨"],[78,39,583,"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا ٣٩"],[78,40,583,"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا ٤٠"],[79,1,583,"وَٱلنَّٰزِعَٰتِ غَرۡقٗا ١"],[79,2,583,"وَٱلنَّٰشِطَٰتِ نَشۡطٗا ٢"],[79,3,583,"وَٱلسَّٰبِحَٰتِ سَبۡحٗا ٣"],[79,4,583,"فَٱلسَّٰبِقَٰتِ سَبۡقٗا ٤"],[79,5,583,"فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا ٥"],[79,6,583,"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ ٦"],[79,7,583,"تَتۡبَعُهَا ٱلرَّادِفَةُ ٧"],[79,8,583,"قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ ٨"],[79,9,583,"أَبۡصَٰرُهَا خَٰشِعَةٞ ٩"],[79,10,583,"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ ١٠"],[79,11,583,"أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ ١١"],[79,12,583,"قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ ١٢"],[79,13,583,"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ ١٣"],[79,14,583,"فَإِذَا هُم بِٱلسَّاهِرَةِ ١٤"],[79,15,583,"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ ١٥"],[79,16,583,"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى ١٦"],[79,17,584,"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ ١٧"],[79,18,584,"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ ١٨"],[79,19,584,"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ ١٩"],[79,20,584,"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ ٢٠"],[79,21,584,"فَكَذَّبَ وَعَصَىٰ ٢١"],[79,22,584,"ثُمَّ أَدۡبَرَ يَسۡعَىٰ ٢٢"],[79,23,584,"فَحَشَرَ فَنَادَىٰ ٢٣"],[79,24,584,"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ ٢٤"],[79,25,584,"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ ٢٥"],[79,26,584,"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ ٢٦"],[79,27,584,"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا ٢٧"],[79,28,584,"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا ٢٨"],[79,29,584,"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا ٢٩"],[79,30,584,"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ ٣٠"],[79,31,584,"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا ٣١"],[79,32,584,"وَٱلۡجِبَالَ أَرۡسَىٰهَا ٣٢"],[79,33,584,"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ٣٣"],[79,34,584,"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ ٣٤"],[79,35,584,"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ ٣٥"],[79,36,584,"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ ٣٦"],[79,37,584,"فَأَمَّا مَن طَغَىٰ ٣٧"],[79,38,584,"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ٣٨"],[79,39,584,"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ ٣٩"],[79,40,584,"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ ٤٠"],[79,41,584,"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ ٤١"],[79,42,584,"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا ٤٢"],[79,43,584,"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ ٤٣"],[79,44,584,"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ ٤٤"],[79,45,584,"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا ٤٥"],[79,46,584,"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا ٤٦"],[80,1,585,"عَبَسَ وَتَوَلَّىٰٓ ١"],[80,2,585,"أَن جَآءَهُ ٱلۡأَعۡمَىٰ ٢"],[80,3,585,"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ٣"],[80,4,585,"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ ٤"],[80,5,585,"أَمَّا مَنِ ٱسۡتَغۡنَىٰ ٥"],[80,6,585,"فَأَنتَ لَهُۥ تَصَدَّىٰ ٦"],[80,7,585,"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ ٧"],[80,8,585,"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ ٨"],[80,9,585,"وَهُوَ يَخۡشَىٰ ٩"],[80,10,585,"فَأَنتَ عَنۡهُ تَلَهَّىٰ ١٠"],[80,11,585,"كـَلَّآ إِنَّهَا تَذۡكِرَةٞ ١١"],[80,12,585,"فَمَن شَآءَ ذَكَرَهُۥ ١٢"],[80,13,585,"فِي صُحُفٖ مُّكَرَّمَةٖ ١٣"],[80,14,585,"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ ١٤"],[80,15,585,"بِأَيۡدِي سَفَرَةٖ ١٥"],[80,16,585,"كِرَامِۭ بَرَرَةٖ ١٦"],[80,17,585,"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ ١٧"],[80,18,585,"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ١٨"],[80,19,585,"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩"],[80,20,585,"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ٢٠"],[80,21,585,"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ٢١"],[80,22,585,"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ٢٢"],[80,23,585,"كـَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ ٢٣"],[80,24,585,"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ٢٤"],[80,25,585,"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا ٢٥"],[80,26,585,"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا ٢٦"],[80,27,585,"فَأَنۢبَتۡنَا فِيهَا حَبّٗا ٢٧"],[80,28,585,"وَعِنَبٗا وَقَضۡبٗا ٢٨"],[80,29,585,"وَزَيۡتُونٗا وَنَخۡلٗا ٢٩"],[80,30,585,"وَحَدَآئِقَ غُلۡبٗا ٣٠"],[80,31,585,"وَفَٰكِهَةٗ وَأَبّٗا ٣١"],[80,32,585,"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ٣٢"],[80,33,585,"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ٣٣"],[80,34,585,"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ ٣٤"],[80,35,585,"وَأُمِّهِۦ وَأَبِيهِ ٣٥"],[80,36,585,"وَصَٰحِبَتِهِۦ وَبَنِيهِ ٣٦"],[80,37,585,"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ ٣٧"],[80,38,585,"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ ٣٨"],[80,39,585,"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ ٣٩"],[80,40,585,"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ ٤٠"],[80,41,586,"تَرۡهَقُهَا قَتَرَةٌ ٤١"],[80,42,586,"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ ٤٢"],[81,1,586,"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ ١"],[81,2,586,"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ ٢"],[81,3,586,"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ ٣"],[81,4,586,"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ ٤"],[81,5,586,"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ ٥"],[81,6,586,"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ ٦"],[81,7,586,"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ ٧"],[81,8,586,"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ ٨"],[81,9,586,"بِأَيِّ ذَنۢبٖ قُتِلَتۡ ٩"],[81,10,586,"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ ١٠"],[81,11,586,"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ ١١"],[81,12,586,"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ ١٢"],[81,13,586,"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ ١٣"],[81,14,586,"عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ ١٤"],[81,15,586,"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ ١٥"],[81,16,586,"ٱلۡجَوَارِ ٱلۡكُنَّسِ ١٦"],[81,17,586,"وَٱلَّيۡلِ إِذَا عَسۡعَسَ ١٧"],[81,18,586,"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ ١٨"],[81,19,586,"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ١٩"],[81,20,586,"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ ٢٠"],[81,21,586,"مُّطَاعٖ ثَمَّ أَمِينٖ ٢١"],[81,22,586,"وَمَا صَاحِبُكُم بِمَجۡنُونٖ ٢٢"],[81,23,586,"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ ٢٣"],[81,24,586,"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ ٢٤"],[81,25,586,"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ ٢٥"],[81,26,586,"فَأَيۡنَ تَذۡهَبُونَ ٢٦"],[81,27,586,"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ٢٧"],[81,28,586,"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ ٢٨"],[81,29,586,"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ ٢٩"],[82,1,587,"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ ١"],[82,2,587,"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ ٢"],[82,3,587,"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ ٣"],[82,4,587,"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ ٤"],[82,5,587,"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ ٥"],[82,6,587,"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ ٦"],[82,7,587,"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ ٧"],[82,8,587,"فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ ٨"],[82,9,587,"كـَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ ٩"],[82,10,587,"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ ١٠"],[82,11,587,"كِرَامٗا كَٰتِبِينَ ١١"],[82,12,587,"يَعۡلَمُونَ مَا تَفۡعَلُونَ ١٢"],[82,13,587,"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ ١٣"],[82,14,587,"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ ١٤"],[82,15,587,"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ ١٥"],[82,16,587,"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ ١٦"],[82,17,587,"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٧"],[82,18,587,"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٨"],[82,19,587,"يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ ١٩"],[83,1,587,"وَيۡلٞ لِّلۡمُطَفِّفِينَ ١"],[83,2,587,"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ ٢"],[83,3,587,"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ ٣"],[83,4,587,"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ ٤"],[83,5,588,"لِيَوۡمٍ عَظِيمٖ ٥"],[83,6,588,"يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ ٦"],[83,7,588,"كـَلَّآ إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ ٧"],[83,8,588,"وَمَآ أَدۡرَىٰكَ مَا سِجِّينٞ ٨"],[83,9,588,"كِتَٰبٞ مَّرۡقُومٞ ٩"],[83,10,588,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٠"],[83,11,588,"ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ ١١"],[83,12,588,"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ ١٢"],[83,13,588,"إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ ١٣"],[83,14,588,"كـَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ ١٤"],[83,15,588,"كـَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ يَوۡمَئِذٖ لَّمَحۡجُوبُونَ ١٥"],[83,16,588,"ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ ١٦"],[83,17,588,"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ ١٧"],[83,18,588,"كـَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ ١٨"],[83,19,588,"وَمَآ أَدۡرَىٰكَ مَا عِلِّيُّونَ ١٩"],[83,20,588,"كِتَٰبٞ مَّرۡقُومٞ ٢٠"],[83,21,588,"يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ ٢١"],[83,22,588,"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ ٢٢"],[83,23,588,"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ ٢٣"],[83,24,588,"تَعۡرِفُ فِي وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ ٢٤"],[83,25,588,"يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ ٢٥"],[83,26,588,"خِتَٰمُهُۥ مِسۡكٞۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ ٢٦"],[83,27,588,"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ ٢٧"],[83,28,588,"عَيۡنٗا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ ٢٨"],[83,29,588,"إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ ٢٩"],[83,30,588,"وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ ٣٠"],[83,31,588,"وَإِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ ٣١"],[83,32,588,"وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ ٣٢"],[83,33,588,"وَمَآ أُرۡسِلُواْ عَلَيۡهِمۡ حَٰفِظِينَ ٣٣"],[83,34,589,"فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ ٣٤"],[83,35,589,"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ ٣٥"],[83,36,589,"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ ٣٦"],[84,1,589,"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ ١"],[84,2,589,"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ٢"],[84,3,589,"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ ٣"],[84,4,589,"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ ٤"],[84,5,589,"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ٥"],[84,6,589,"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ ٦"],[84,7,589,"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ ٧"],[84,8,589,"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا ٨"],[84,9,589,"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا ٩"],[84,10,589,"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ ١٠"],[84,11,589,"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا ١١"],[84,12,589,"وَيَصۡلَىٰ سَعِيرًا ١٢"],[84,13,589,"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا ١٣"],[84,14,589,"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ ١٤"],[84,15,589,"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا ١٥"],[84,16,589,"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ ١٦"],[84,17,589,"وَٱلَّيۡلِ وَمَا وَسَقَ ١٧"],[84,18,589,"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ ١٨"],[84,19,589,"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ ١٩"],[84,20,589,"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ ٢٠"],[84,21,589,"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩ ٢١"],[84,22,589,"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ ٢٢"],[84,23,589,"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ ٢٣"],[84,24,589,"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ ٢٤"],[84,25,590,"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ ٢٥"],[85,1,590,"وَٱلسَّمَآءِ ذَاتِ ٱلۡبُرُوجِ ١"],[85,2,590,"وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ ٢"],[85,3,590,"وَشَاهِدٖ وَمَشۡهُودٖ ٣"],[85,4,590,"قُتِلَ أَصۡحَٰبُ ٱلۡأُخۡدُودِ ٤"],[85,5,590,"ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ ٥"],[85,6,590,"إِذۡ هُمۡ عَلَيۡهَا قُعُودٞ ٦"],[85,7,590,"وَهُمۡ عَلَىٰ مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودٞ ٧"],[85,8,590,"وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ ٨"],[85,9,590,"ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ ٩"],[85,10,590,"إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ ١٠"],[85,11,590,"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡكَبِيرُ ١١"],[85,12,590,"إِنَّ بَطۡشَ رَبِّكَ لَشَدِيدٌ ١٢"],[85,13,590,"إِنَّهُۥ هُوَ يُبۡدِئُ وَيُعِيدُ ١٣"],[85,14,590,"وَهُوَ ٱلۡغَفُورُ ٱلۡوَدُودُ ١٤"],[85,15,590,"ذُو ٱلۡعَرۡشِ ٱلۡمَجِيدُ ١٥"],[85,16,590,"فَعَّالٞ لِّمَا يُرِيدُ ١٦"],[85,17,590,"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡجُنُودِ ١٧"],[85,18,590,"فِرۡعَوۡنَ وَثَمُودَ ١٨"],[85,19,590,"بَلِ ٱلَّذِينَ كَفَرُواْ فِي تَكۡذِيبٖ ١٩"],[85,20,590,"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطُۢ ٢٠"],[85,21,590,"بَلۡ هُوَ قُرۡءَانٞ مَّجِيدٞ ٢١"],[85,22,590,"فِي لَوۡحٖ مَّحۡفُوظِۭ ٢٢"],[86,1,591,"وَٱلسَّمَآءِ وَٱلطَّارِقِ ١"],[86,2,591,"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ ٢"],[86,3,591,"ٱلنَّجۡمُ ٱلثَّاقِبُ ٣"],[86,4,591,"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ ٤"],[86,5,591,"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ ٥"],[86,6,591,"خُلِقَ مِن مَّآءٖ دَافِقٖ ٦"],[86,7,591,"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ ٧"],[86,8,591,"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ ٨"],[86,9,591,"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ ٩"],[86,10,591,"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ ١٠"],[86,11,591,"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ ١١"],[86,12,591,"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ ١٢"],[86,13,591,"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ ١٣"],[86,14,591,"وَمَا هُوَ بِٱلۡهَزۡلِ ١٤"],[86,15,591,"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا ١٥"],[86,16,591,"وَأَكِيدُ كَيۡدٗا ١٦"],[86,17,591,"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا ١٧"],[87,1,591,"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى ١"],[87,2,591,"ٱلَّذِي خَلَقَ فَسَوَّىٰ ٢"],[87,3,591,"وَٱلَّذِي قَدَّرَ فَهَدَىٰ ٣"],[87,4,591,"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ ٤"],[87,5,591,"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ ٥"],[87,6,591,"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ ٦"],[87,7,591,"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ ٧"],[87,8,591,"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ ٨"],[87,9,591,"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ ٩"],[87,10,591,"سَيَذَّكَّرُ مَن يَخۡشَىٰ ١٠"],[87,11,592,"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى ١١"],[87,12,592,"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ ١٢"],[87,13,592,"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ ١٣"],[87,14,592,"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ ١٤"],[87,15,592,"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ ١٥"],[87,16,592,"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ١٦"],[87,17,592,"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ ١٧"],[87,18,592,"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ ١٨"],[87,19,592,"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ ١٩"],[88,1,592,"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ ١"],[88,2,592,"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ ٢"],[88,3,592,"عَامِلَةٞ نَّاصِبَةٞ ٣"],[88,4,592,"تَصۡلَىٰ نَارًا حَامِيَةٗ ٤"],[88,5,592,"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ ٥"],[88,6,592,"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ ٦"],[88,7,592,"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ ٧"],[88,8,592,"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ ٨"],[88,9,592,"لِّسَعۡيِهَا رَاضِيَةٞ ٩"],[88,10,592,"فِي جَنَّةٍ عَالِيَةٖ ١٠"],[88,11,592,"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ ١١"],[88,12,592,"فِيهَا عَيۡنٞ جَارِيَةٞ ١٢"],[88,13,592,"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ ١٣"],[88,14,592,"وَأَكۡوَابٞ مَّوۡضُوعَةٞ ١٤"],[88,15,592,"وَنَمَارِقُ مَصۡفُوفَةٞ ١٥"],[88,16,592,"وَزَرَابِيُّ مَبۡثُوثَةٌ ١٦"],[88,17,592,"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ ١٧"],[88,18,592,"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ ١٨"],[88,19,592,"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ ١٩"],[88,20,592,"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ ٢٠"],[88,21,592,"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ ٢١"],[88,22,592,"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ ٢٢"],[88,23,593,"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ٢٣"],[88,24,593,"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ ٢٤"],[88,25,593,"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ ٢٥"],[88,26,593,"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم ٢٦"],[89,1,593,"وَٱلۡفَجۡرِ ١"],[89,2,593,"وَلَيَالٍ عَشۡرٖ ٢"],[89,3,593,"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ٣"],[89,4,593,"وَٱلَّيۡلِ إِذَا يَسۡرِ ٤"],[89,5,593,"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ ٥"],[89,6,593,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ٦"],[89,7,593,"إِرَمَ ذَاتِ ٱلۡعِمَادِ ٧"],[89,8,593,"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ٨"],[89,9,593,"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ ٩"],[89,10,593,"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ١٠"],[89,11,593,"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ١١"],[89,12,593,"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ١٢"],[89,13,593,"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ١٣"],[89,14,593,"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ١٤"],[89,15,593,"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ ١٥"],[89,16,593,"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ ١٦"],[89,17,593,"كـَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ١٧"],[89,18,593,"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ١٨"],[89,19,593,"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّ