5,"وَنَفۡسٖ وَمَا سَوَّىٰهَا ٧"],[91,8,595,"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا ٨"],[91,9,595,"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا ٩"],[91,10,595,"وَقَدۡ خَابَ مَن دَسَّىٰهَا ١٠"],[91,11,595,"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ ١١"],[91,12,595,"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا ١٢"],[91,13,595,"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا ١٣"],[91,14,595,"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا ١٤"],[91,15,595,"وَلَا يَخَافُ عُقۡبَٰهَا ١٥"],[92,1,595,"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ ١"],[92,2,595,"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ ٢"],[92,3,595,"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ٣"],[92,4,595,"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ ٤"],[92,5,595,"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ ٥"],[92,6,595,"وَصَدَّقَ بِٱلۡحُسۡنَىٰ ٦"],[92,7,595,"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ ٧"],[92,8,595,"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ ٨"],[92,9,595,"وَكَذَّبَ بِٱلۡحُسۡنَىٰ ٩"],[92,10,596,"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ ١٠"],[92,11,596,"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ ١١"],[92,12,596,"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ ١٢"],[92,13,596,"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ ١٣"],[92,14,596,"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ ١٤"],[92,15,596,"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى ١٥"],[92,16,596,"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ ١٦"],[92,17,596,"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى ١٧"],[92,18,596,"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ ١٨"],[92,19,596,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ ١٩"],[92,20,596,"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ ٢٠"],[92,21,596,"وَلَسَوۡفَ يَرۡضَىٰ ٢١"],[93,1,596,"وَٱلضُّحَىٰ ١"],[93,2,596,"وَٱلَّيۡلِ إِذَا سَجَىٰ ٢"],[93,3,596,"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ٣"],[93,4,596,"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ ٤"],[93,5,596,"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ ٥"],[93,6,596,"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ ٦"],[93,7,596,"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ ٧"],[93,8,596,"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ ٨"],[93,9,596,"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ ٩"],[93,10,596,"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ ١٠"],[93,11,596,"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ١١"],[94,1,596,"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ١"],[94,2,596,"وَوَضَعۡنَا عَنكَ وِزۡرَكَ ٢"],[94,3,597,"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ ٣"],[94,4,597,"وَرَفَعۡنَا لَكَ ذِكۡرَكَ ٤"],[94,5,597,"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا ٥"],[94,6,597,"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا ٦"],[94,7,597,"فَإِذَا فَرَغۡتَ فَٱنصَبۡ ٧"],[94,8,597,"وَإِلَىٰ رَبِّكَ فَٱرۡغَب ٨"],[95,1,597,"وَٱلتِّينِ وَٱلزَّيۡتُونِ ١"],[95,2,597,"وَطُورِ سِينِينَ ٢"],[95,3,597,"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ ٣"],[95,4,597,"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ ٤"],[95,5,597,"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ ٥"],[95,6,597,"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ ٦"],[95,7,597,"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ ٧"],[95,8,597,"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ ٨"],[96,1,597,"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ ١"],[96,2,597,"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ ٢"],[96,3,597,"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ ٣"],[96,4,597,"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ ٤"],[96,5,597,"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ ٥"],[96,6,597,"كـَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ ٦"],[96,7,597,"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ ٧"],[96,8,597,"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ ٨"],[96,9,597,"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ ٩"],[96,10,597,"عَبۡدًا إِذَا صَلَّىٰٓ ١٠"],[96,11,597,"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ ١١"],[96,12,597,"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ ١٢"],[96,13,598,"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ ١٣"],[96,14,598,"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ ١٤"],[96,15,598,"كـَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ ١٥"],[96,16,598,"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ ١٦"],[96,17,598,"فَلۡيَدۡعُ نَادِيَهُۥ ١٧"],[96,18,598,"سَنَدۡعُ ٱلزَّبَانِيَةَ ١٨"],[96,19,598,"كـَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩ ١٩"],[97,1,598,"إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ ١"],[97,2,598,"وَمَآ أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ ٢"],[97,3,598,"لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ ٣"],[97,4,598,"تَنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ ٤"],[97,5,598,"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ ٥"],[98,1,598,"لَمۡ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأۡتِيَهُمُ ٱلۡبَيِّنَةُ ١"],[98,2,598,"رَسُولٞ مِّنَ ٱللَّهِ يَتۡلُواْ صُحُفٗا مُّطَهَّرَةٗ ٢"],[98,3,598,"فِيهَا كُتُبٞ قَيِّمَةٞ ٣"],[98,4,598,"وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ إِلَّا مِنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَةُ ٤"],[98,5,598,"وَمَآ أُمِرُوٓاْ إِلَّا لِيَعۡبُدُواْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُواْ ٱلصَّلَوٰةَ وَيُؤۡتُواْ ٱلزَّكَوٰةَۚ وَذَٰلِكَ دِينُ ٱلۡقَيِّمَةِ ٥"],[98,6,599,"إِنَّ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ فِي نَارِ جَهَنَّمَ خَٰلِدِينَ فِيهَآۚ أُوْلَٰٓئِكَ هُمۡ شَرُّ ٱلۡبَرِيَّةِ ٦"],[98,7,599,"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ أُوْلَٰٓئِكَ هُمۡ خَيۡرُ ٱلۡبَرِيَّةِ ٧"],[98,8,599,"جَزَآؤُهُمۡ عِندَ رَبِّهِمۡ جَنَّٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ رَّضِيَ ٱللَّهُ عَنۡهُمۡ وَرَضُواْ عَنۡهُۚ ذَٰلِكَ لِمَنۡ خَشِيَ رَبَّهُۥ ٨"],[99,1,599,"إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا ١"],[99,2,599,"وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا ٢"],[99,3,599,"وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا ٣"],[99,4,599,"يَوۡمَئِذٖ تُحَدِّثُ أَخۡبَارَهَا ٤"],[99,5,599,"بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا ٥"],[99,6,599,"يَوۡمَئِذٖ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتٗا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ ٦"],[99,7,599,"فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرٗا يَرَهُۥ ٧"],[99,8,599,"وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٖ شَرّٗا يَرَهُۥ ٨"],[100,1,599,"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا ١"],[100,2,599,"فَٱلۡمُورِيَٰتِ قَدۡحٗا ٢"],[100,3,599,"فَٱلۡمُغِيرَٰتِ صُبۡحٗا ٣"],[100,4,599,"فَأَثَرۡنَ بِهِۦ نَقۡعٗا ٤"],[100,5,599,"فَوَسَطۡنَ بِهِۦ جَمۡعًا ٥"],[100,6,600,"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦"],[100,7,600,"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧"],[100,8,600,"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ ٨"],[100,9,600,"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ ٩"],[100,10,600,"وَحُصِّلَ مَا فِي ٱلصُّدُورِ ١٠"],[100,11,600,"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ ١١"],[101,1,600,"ٱلۡقَارِعَةُ ١"],[101,2,600,"مَا ٱلۡقَارِعَةُ ٢"],[101,3,600,"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ ٣"],[101,4,600,"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ ٤"],[101,5,600,"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ ٥"],[101,6,600,"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ٦"],[101,7,600,"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ ٧"],[101,8,600,"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ٨"],[101,9,600,"فَأُمُّهُۥ هَاوِيَةٞ ٩"],[101,10,600,"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ ١٠"],[101,11,600,"نَارٌ حَامِيَةُۢ ١١"],[102,1,600,"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ ١"],[102,2,600,"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ ٢"],[102,3,600,"كـَلَّا سَوۡفَ تَعۡلَمُونَ ٣"],[102,4,600,"ثُمَّ كـَلَّا سَوۡفَ تَعۡلَمُونَ ٤"],[102,5,600,"كـَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ ٥"],[102,6,600,"لَتَرَوُنَّ ٱلۡجَحِيمَ ٦"],[102,7,600,"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ ٧"],[102,8,600,"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ ٨"],[103,1,601,"وَٱلۡعَصۡرِ ١"],[103,2,601,"إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ ٢"],[103,3,601,"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ ٣"],[104,1,601,"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ١"],[104,2,601,"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ ٢"],[104,3,601,"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ ٣"],[104,4,601,"كـَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ ٤"],[104,5,601,"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ ٥"],[104,6,601,"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ ٦"],[104,7,601,"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ ٧"],[104,8,601,"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ ٨"],[104,9,601,"فِي عَمَدٖ مُّمَدَّدَةِۭ ٩"],[105,1,601,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ ١"],[105,2,601,"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ ٢"],[105,3,601,"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ ٣"],[105,4,601,"تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ ٤"],[105,5,601,"فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ ٥"],[106,1,602,"لِإِيلَٰفِ قُرَيۡشٍ ١"],[106,2,602,"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ ٢"],[106,3,602,"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ ٣"],[106,4,602,"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ ٤"],[107,1,602,"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ ١"],[107,2,602,"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ ٢"],[107,3,602,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ٣"],[107,4,602,"فَوَيۡلٞ لِّلۡمُصَلِّينَ ٤"],[107,5,602,"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ ٥"],[107,6,602,"ٱلَّذِينَ هُمۡ يُرَآءُونَ ٦"],[107,7,602,"وَيَمۡنَعُونَ ٱلۡمَاعُونَ ٧"],[108,1,602,"إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ ١"],[108,2,602,"فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ ٢"],[108,3,602,"إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ ٣"],[109,1,603,"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ ١"],[109,2,603,"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ ٢"],[109,3,603,"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ ٣"],[109,4,603,"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ ٤"],[109,5,603,"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ ٥"],[109,6,603,"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ ٦"],[110,1,603,"إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ ١"],[110,2,603,"وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجٗا ٢"],[110,3,603,"فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا ٣"],[111,1,603,"تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ ١"],[111,2,603,"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ ٢"],[111,3,603,"سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ ٣"],[111,4,603,"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ ٤"],[111,5,603,"فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۭ ٥"],[112,1,604,"قُلۡ هُوَ ٱللَّهُ أَحَدٌ ١"],[112,2,604,"ٱللَّهُ ٱلصَّمَدُ ٢"],[112,3,604,"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ ٣"],[112,4,604,"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ ٤"],[113,1,604,"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ ١"],[113,2,604,"مِن شَرِّ مَا خَلَقَ ٢"],[113,3,604,"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ ٣"],[113,4,604,"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ ٤"],[113,5,604,"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ ٥"],[114,1,604,"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ ١"],[114,2,604,"مَلِكِ ٱلنَّاسِ ٢"],[114,3,604,"إِلَٰهِ ٱلنَّاسِ ٣"],[114,4,604,"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ ٤"],[114,5,604,"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ ٥"],[114,6,604,"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ ٦"]]